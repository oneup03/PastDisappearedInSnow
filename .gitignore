# Player-supplied inputs. Never commit ROM, BIOS or recording data.
*.bs
*.sfc
*.smc
*.bin
*.zip
*.divx
*.avi
*.mp3
*.wav
*.pcm

# Anything derived from those inputs
/inputs/
/audio/
/text-dump/
/images/
# Players' own soundtrack albums
/soundtrack
/src/gen/
/recomp/*/funcs.h
*.srm
*.state

# Local reference captures (traces, savestates, frame dumps)
/local/

# Build output and tooling
/build/
/.cache/
__pycache__/
*.pyc

# Scaffold-generated and per-machine state
/build-*/
/dist/
/saves/
/rom_probe.json
/rom.cfg
/keybinds.ini
/config.ini
/input.ini
.DS_Store
/.vscode/

# Agent and AI working files stay local
/CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.codex/
.aider*
/docs/PLAN.md
/docs/HANDOFF-*.md

/last_run_report.json
